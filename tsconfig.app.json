{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "next": ["src/shims/next.ts"],
      "next/font/google": ["src/shims/next-font-google.ts"],
      "next/font/*": ["src/shims/next-font-*.ts"],
      "next/image": ["src/shims/next-image.tsx"],
      "next/link": ["src/shims/next-link.tsx"],
      "next/navigation": ["src/shims/next-navigation.ts"],
      "next/script": ["src/shims/next-script.tsx"],
      "next/dynamic": ["src/shims/next-dynamic.tsx"],
      "next/*": ["src/shims/next-*.ts", "src/shims/next-*.tsx"]
    },

    /* Linting */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
